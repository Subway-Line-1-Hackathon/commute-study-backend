# 로컬 개발용 DB 접속 정보 템플릿
#
# 사용법:
#   1. 이 파일을 복사해서 프로젝트 루트에 .env 로 저장한다. (.env 는 .gitignore 처리되어 있음)
#   2. Supabase 프로젝트 > Project Settings > Database > Connection string > Connection pooling
#      (Transaction mode, 6543 포트) 에서 아래 값을 확인해 채운다.
#   3. 비밀번호는 깃/슬랙 공개 채널이 아닌 팀원과의 별도 채널로 공유한다.

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<db-password>
