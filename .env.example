# 로컬 개발용 DB 접속 정보 템플릿
#
# 사용법:
#   1. 이 파일을 복사해서 프로젝트 루트에 .env 로 저장한다. (.env 는 .gitignore 처리되어 있음)
#   2. Supabase 프로젝트 > Project Settings > Database > Connection string 에서 아래 값을 확인해 채운다.
#      - spring.datasource.* : Connection pooling (Transaction mode, 6543 포트) — 앱 런타임용
#      - spring.flyway.*     : Session/Direct connection (5432 포트) — 마이그레이션 전용
#        (6543 Transaction 모드는 Flyway의 advisory lock과 호환되지 않아 별도로 분리한다)
#   3. 비밀번호는 깃/슬랙 공개 채널이 아닌 팀원과의 별도 채널로 공유한다.

spring.datasource.url=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
spring.datasource.username=postgres.<project-ref>
spring.datasource.password=<db-password>

spring.flyway.url=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
spring.flyway.user=postgres.<project-ref>
spring.flyway.password=<db-password>

# 구글 로그인(Supabase Auth) JWT 검증용. Supabase 대시보드 > Project Settings > API > Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Swagger UI Google 로그인용 공개 키. publishable 키를 권장한다.
# service_role, sb_secret_*, JWT Secret은 절대로 넣지 않는다.
# 미설정이면 Google 로그인만 비활성화되고 수동 Authorize는 계속 사용할 수 있다.
SUPABASE_PUBLISHABLE_KEY=
# 구형 프로젝트에서는 위 항목을 제거하고 SUPABASE_ANON_KEY=<anon-key> 사용 가능

# AI 서버(commute-study-ai) 호출용. Railway 내부망 주소는 로컬에서 못 열리니, 로컬 개발은
# commute-study-ai를 AI_MOCK=true로 직접 띄우고(uvicorn app.main:app, 기본 8000) 아래처럼 연결한다.
# AI_INTERNAL_KEY는 백엔드와 AI 서버가 같은 값을 써야 한다.
AI_SERVER_URL=http://localhost:8000
AI_INTERNAL_KEY=<ai-서버와-같은-값>

# 선택: 허용할 프론트 출처를 쉼표로 구분 (미설정 시 기존 로컬 출처 4개 사용)
# app.cors.allowed-origins=http://localhost:5500,https://frontend.example.com

# 슬라이스 8: 서버 전용 비공개 Storage (실제 값은 별도 설정)
# Supabase에서 미리 만든 private bucket 이름. public bucket은 업로드를 거절한다.
SUPABASE_STORAGE_BUCKET=
# service_role JWT 또는 sb_secret_* 서버 키. publishable/anon 키를 사용하지 않는다.
# 이 키는 Swagger/프론트에 노출하지 않는다.
SUPABASE_STORAGE_KEY=
# AI 서버 SUPABASE_HOST와 동일한 호스트명(https:// 및 경로 제외)
SUPABASE_HOST=
# 파일 다운로드 서명 URL 유효시간(분). AI 담당과 합의 필요, 기본 10분
# AI_SIGNED_URL_TTL_MINUTES=10
# 개발·데모용: true이면 요청의 X-Mock-Error 헤더(예: LLM_TIMEOUT)를 AI 서버로 넘겨 실패 경로를 시험한다. 운영에서는 false
# AI_MOCK_ERROR_PASSTHROUGH=false

# 슬라이스 10: 공유 DB를 쓰는 로컬에서는 반드시 false 유지.
# 운영 Railway 단일 인스턴스에서 V5 적용 및 Storage 권한 확인 후 true로 활성화.
# 매일 03:00 KST 원본 정리 + 업로드/처리 완료 후 정리 + 1분 주기 고착 복구를 함께 제어.
MATERIAL_CLEANUP_ENABLED=false
