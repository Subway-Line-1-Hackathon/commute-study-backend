# 로컬 개발용 DB 접속 정보 템플릿
#
# 사용법:
#   1. 이 파일을 복사해서 프로젝트 루트에 .env 로 저장한다. (.env 는 .gitignore 처리되어 있음)
#   2. Supabase 프로젝트 > Project Settings > Database > Connection string 에서 아래 값을 확인해 채운다.
#      - spring.datasource.* : Connection pooling (Transaction mode, 6543 포트) — 앱 런타임용
#      - spring.flyway.*     : Session/Direct connection (5432 포트) — 마이그레이션 전용
#        (6543 Transaction 모드는 Flyway의 advisory lock과 호환되지 않아 별도로 분리한다)
#   3. 비밀번호는 깃/슬랙 공개 채널이 아닌 팀원과의 별도 채널로 공유한다.

spring.datasource.url=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
spring.datasource.username=postgres.<project-ref>
spring.datasource.password=<db-password>

spring.flyway.url=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
spring.flyway.user=postgres.<project-ref>
spring.flyway.password=<db-password>

# 선택: 허용할 프론트 출처를 쉼표로 구분 (미설정 시 기존 로컬 출처 4개 사용)
# app.cors.allowed-origins=http://localhost:5500,https://frontend.example.com
